{
  "name": "garmin-connect-sdk",
  "version": "1.0.0-alpha.1",
  "description": "Unofficial Node.js TypeScript SDK for reading a user's own Garmin Connect data.",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "license": "MIT",
  "author": "",
  "keywords": [
    "garmin",
    "garmin-connect",
    "typescript",
    "sdk",
    "nodejs",
    "fitness",
    "health"
  ],
  "homepage": "https://github.com/marceltuinstra/garmin-connect-sdk#readme",
  "bugs": {
    "url": "https://github.com/marceltuinstra/garmin-connect-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marceltuinstra/garmin-connect-sdk.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/garmin-smoke.mjs",
    "garmin": "node scripts/garmin.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
